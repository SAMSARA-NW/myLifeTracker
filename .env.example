# Public browser configuration only. Never place service_role or sb_secret keys here.
VITE_SUPABASE_URL=https://your-personal-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_BUSINESS_SUPABASE_URL=https://your-business-project.supabase.co
# This must be a publishable/anon key after authenticated access is implemented.
# Do not bypass the security check with a privileged key.
VITE_BUSINESS_SUPABASE_KEY=your-publishable-or-anon-key
# Public identifier of the single authorised business account; also enforced by RLS.
VITE_BUSINESS_OWNER_ID=your-business-auth-user-uuid
